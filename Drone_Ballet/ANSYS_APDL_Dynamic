
     
! =====================================================================
! ANSYS MECHANICAL COMMANDS - TRANSIENT THERMAL
! INITIAL TEMPERATURE = 27 C (INITIAL CONDITION ONLY, NOT FIXED)
! ROTATING DRONE / STATIONARY LASER / NATURAL CONVECTION
!
! Model: existing Workbench mesh and Engineering Data properties.
! Units: m, kg, s, W, C.
!
! REQUIRED NODAL COMPONENTS (FACE-BASED NAMED SELECTIONS):
!   LASER_PATH    - complete external faces eligible for laser heating
!   EXPOSED_SURF  - all external faces that see ambient air
!
! This snippet MUST NOT be accompanied by duplicate native convection
! or native heat-flux loads on the same faces. Do not add SOLVE.
!
! Surface loading strategy:
! - Moving laser HFLUX is applied to the SOLID291 faces.
! - Natural convection acts on separate, overlaid SURF152 elements.
! This permits both physical effects at the same surface WITHOUT
! prescribing, resetting, or clamping temperatures.
!
! Intended for existing SOLID291 (10-node tetrahedral thermal) mesh,
! as identified in the 2026-10-27 solver log.
! =====================================================================

! --------------------- USER PARAMETERS -------------------------------
TINIT           = 27.0
TAMB            = 27.0
TEND            = 15.0
DT              = 0.01

ROT_DEG_S       = 0.0
ROT_DELAY       = 0.50
LASER_START     = 0.0
LASER_RAMP      = 0.10
LASER_Y_OFFSET  = 0.0
USE_LASER       = 1
USE_CONV        = 0 ! boolean 0 off, 1 on

P0              = 5000.0
ALPHA_ATM       = 0.00015
LAM             = 1064E-9
BEAM_D          = 0.10
M2FAC           = 1.5
ABSORB          = 1.0
SLANT           = 500.0
DH              = 200.0
NCUT            = 3.0
PATTERN_YAW_DEG = 0.0
XSHIFT          = 0.0
YSHIFT          = 0.0

GRAV            = 9.81
PAMB            = 101325.0
RGAS            = 287.05
CPAIR           = 1006.0
TREF_AIR        = 300.0
MU_REF          = 1.846E-5
K_REF           = 0.0263
SUTH            = 110.4
AUTO_LCHAR      = 1
LCHAR           = 0.05
TS_MAX          = 2000.0
NTAB            = 41

! -------------------------- PREP7 ------------------------------------
FINISH
/PREP7
ALLSEL,ALL
CSYS,0

! Quadratic thermal elements: diagonalize specific-heat matrix.
! This is a spatial discretization choice, NOT a temperature correction.
! It can reduce nonphysical undershoot associated with consistent matrices.
*GET,NELEM_ALL,ELEM,0,COUNT
*GET,MAXTYP,ETYP,0,NUM,MAX
*DIM,SEENTYP,ARRAY,MAXTYP
*GET,EID,ELEM,0,NUM,MIN
NDIAG = 0
*DO,IE,1,NELEM_ALL
    *GET,TYPID,ELEM,EID,ATTR,TYPE
    *IF,SEENTYP(TYPID),EQ,0,THEN
        SEENTYP(TYPID) = 1
        *GET,ENAME,ETYP,TYPID,ATTR,ENAM
        *IF,ENAME,EQ,291,THEN
            KEYOPT,TYPID,15,1
            NDIAG = NDIAG+1
        *ENDIF
        *IF,ENAME,EQ,279,THEN
            KEYOPT,TYPID,15,1
            NDIAG = NDIAG+1
        *ENDIF
    *ENDIF
    EID = ELNEXT(EID)
*ENDDO
ALLSEL,ALL

! ----------------- VERIFY NAMED SELECTIONS ---------------------------
CMSEL,S,LASER_PATH,NODE
*GET,NPATH,NODE,0,COUNT
*IF,NPATH,LT,4,THEN
    *MSG,FATAL
    LASER_PATH must contain exterior face nodes
*ENDIF

*GET,XMINP,NODE,0,MNLOC,X
*GET,XMAXP,NODE,0,MXLOC,X
*GET,YMINP,NODE,0,MNLOC,Y
*GET,YMAXP,NODE,0,MXLOC,Y
*GET,ZMINP,NODE,0,MNLOC,Z
*GET,ZMAXP,NODE,0,MXLOC,Z
XCEN  = 0.5*(XMINP+XMAXP)
YCEN  = 0.5*(YMINP+YMAXP)
ZCEN  = 0.5*(ZMINP+ZMAXP)
YBEAM = YCEN+LASER_Y_OFFSET

ALLSEL,ALL
CMSEL,S,EXPOSED_SURF,NODE
*GET,NEXPOSED,NODE,0,COUNT
*IF,NEXPOSED,LT,4,THEN
    *MSG,FATAL
    EXPOSED_SURF must contain exterior face nodes
*ENDIF
*GET,YMIN_EXP,NODE,0,MNLOC,Y
*GET,YMAX_EXP,NODE,0,MXLOC,Y
HEIGHT_EXP = YMAX_EXP-YMIN_EXP
*IF,AUTO_LCHAR,EQ,1,THEN
    LCHAR = HEIGHT_EXP
*ENDIF
*IF,LCHAR,LT,0.001,THEN
    LCHAR = 0.05
*ENDIF
ALLSEL,ALL

! ----------------- NATURAL CONVECTION h(T) ---------------------------
! Churchill-Chu vertical plate correlation, using film temperature.
! The correlation assumes global Y is vertical. The model remains
! stationary; forced convection due to rotation is not included.
!
! Store h as HF versus film temperature for a new material number.
*GET,MAXMAT,MAT,0,NUM,MAX
*GET,MAXMATUSED,ELEM,0,MATM
MAT_HF = MAXMAT+1
*IF,MAXMATUSED,GE,MAT_HF,THEN
    MAT_HF = MAXMATUSED+1
*ENDIF
HMIN_NAT = 1E30
HMAX_NAT = 0.0

*IF,USE_CONV,EQ,1,THEN
    MPTEMP
    *DO,I,1,NTAB
        TSURF_C = TAMB+(I-1)*(TS_MAX-TAMB)/(NTAB-1)
        TFILM_C = 0.5*(TSURF_C+TAMB)
        TFILM_K = TFILM_C+273.15
        DELTAT  = ABS(TSURF_C-TAMB)
        RHO_AIR = PAMB/(RGAS*TFILM_K)
        MU_AIR  = MU_REF*(TFILM_K/TREF_AIR)**1.5
        MU_AIR  = MU_AIR*(TREF_AIR+SUTH)/(TFILM_K+SUTH)
        K_AIR   = K_REF*(TFILM_K/TREF_AIR)**0.85
        NU_AIR  = MU_AIR/RHO_AIR
        ALPHA_AIR = K_AIR/(RHO_AIR*CPAIR)
        PR_AIR  = MU_AIR*CPAIR/K_AIR
        BETA_AIR = 1.0/TFILM_K
        RA_AIR = GRAV*BETA_AIR*DELTAT*LCHAR**3
        RA_AIR = RA_AIR/(NU_AIR*ALPHA_AIR)
        CC_DEN = (1.0+(0.492/PR_AIR)**(9.0/16.0))**(8.0/27.0)
        NU_BAR = (0.825+0.387*RA_AIR**(1.0/6.0)/CC_DEN)**2
        HLOCAL = NU_BAR*K_AIR/LCHAR
        MPTEMP,I,TFILM_C
        MPDATA,HF,MAT_HF,I,HLOCAL
        *IF,HLOCAL,LT,HMIN_NAT,THEN
            HMIN_NAT = HLOCAL
        *ENDIF
        *IF,HLOCAL,GT,HMAX_NAT,THEN
            HMAX_NAT = HLOCAL
        *ENDIF
    *ENDDO
*ENDIF

! ------------ SEPARATE CONVECTION SURFACE ELEMENTS ------------------
! Do not apply CONV to the same SOLID291 face receiving HFLUX.
! Instead generate SURF152 on EXPOSED_SURF and put CONV there.
! ESURF detects complete faces among selected SOLID291 elements.
*GET,MAXTYP2,ETYP,0,NUM,MAX
*GET,MAXREAL,RCON,0,NUM,MAX
ET_SURF = MAXTYP2+1
RC_SURF = MAXREAL+1
ET,ET_SURF,152
KEYOPT,ET_SURF,4,0
KEYOPT,ET_SURF,5,0
KEYOPT,ET_SURF,8,2
R,RC_SURF

*IF,USE_CONV,EQ,1,THEN
    ALLSEL,ALL
    ESEL,S,ENAME,,291
    CMSEL,S,EXPOSED_SURF,NODE
    TYPE,ET_SURF
    REAL,RC_SURF
    MAT,MAT_HF
    ESURF
    ALLSEL,ALL
    ESEL,S,TYPE,,ET_SURF
    *GET,NSURF,ELEM,0,COUNT
    *IF,NSURF,LT,1,THEN
        *MSG,FATAL
        No SURF152 elements generated on EXPOSED_SURF
    *ENDIF
    ! SFE convection: KVAL 1 = film coefficient; 2 = bulk temp.
    SFE,ALL,1,CONV,1,-MAT_HF
    SFE,ALL,1,CONV,2,TAMB
*ENDIF
ALLSEL,ALL

! ------------------------- LASER MODEL -------------------------------
! Preserves original supplied beam physics and geometric mapping.
*AFUN,RAD
PI = ACOS(-1.0)
OMEGA = ROT_DEG_S*PI/180.0
PHI   = PATTERN_YAW_DEG*PI/180.0
CPHI  = COS(PHI)
SPHI  = SIN(PHI)
NTIME = NINT(TEND/DT)+1

HORIZ = SQRT(SLANT**2-DH**2)
THETA = ATAN2(HORIZ,DH)
COST  = COS(THETA)
*IF,COST,LT,0.2,THEN
    COST = 0.2
*ENDIF
*IF,COST,GT,1.0,THEN
    COST = 1.0
*ENDIF
W0      = BEAM_D/(PI*M2FAC)
WBEAM   = SQRT(W0**2+(LAM*SLANT)**2)
PTARGET = P0*EXP(-ALPHA_ATM*SLANT)
QPEAK   = ABSORB*2.0*PTARGET*COST/(PI*WBEAM**2)
RCUT    = NCUT*WBEAM
RCUT2   = RCUT**2

*DIM,YPATH,ARRAY,NPATH
*DIM,RPATH,ARRAY,NPATH
*DIM,APATH,ARRAY,NPATH
*DIM,QPATH,TABLE,NTIME,NPATH,1,TIME,NODE

ALLSEL,ALL
CMSEL,S,LASER_PATH,NODE
*GET,NID,NODE,0,NUM,MIN
*DO,J,1,NPATH
    *GET,XN,NODE,NID,LOC,X
    *GET,YN,NODE,NID,LOC,Y
    *GET,ZN,NODE,NID,LOC,Z
    DX = XN-XCEN
    DZ = ZN-ZCEN
    RLOC = SQRT(DX**2+DZ**2)
    YPATH(J) = YN
    RPATH(J) = RLOC
    *IF,RLOC,GT,1E-12,THEN
        APATH(J) = ATAN2(DZ,DX)
    *ELSE
        APATH(J) = 0.0
    *ENDIF
    QPATH(0,J) = NID
    NID = NDNEXT(NID)
*ENDDO

QTABLEMAX = 0.0
*DO,I,1,NTIME
    TCUR = (I-1)*DT
    *IF,I,EQ,NTIME,THEN
        TCUR = TEND
    *ENDIF
    QPATH(I,0) = TCUR
    RAMP = 0.0
    *IF,TCUR,GT,LASER_START,THEN
        RAMP = (TCUR-LASER_START)/LASER_RAMP
        *IF,RAMP,GT,1.0,THEN
            RAMP = 1.0
        *ENDIF
    *ENDIF
    TROT = TCUR-ROT_DELAY
    *IF,TROT,LT,0.0,THEN
        TROT = 0.0
    *ENDIF
    THBEAM = OMEGA*TROT
    *DO,J,1,NPATH
        DTHETA = ATAN2(SIN(APATH(J)-THBEAM),COS(APATH(J)-THBEAM))
        XLOCAL = RPATH(J)*DTHETA
        YLOCAL = YPATH(J)-YBEAM
        XROT = CPHI*XLOCAL+SPHI*YLOCAL
        YROT = -SPHI*XLOCAL+CPHI*YLOCAL
        XR = XROT-XSHIFT
        YR = YROT/COST-YSHIFT
        R2 = XR**2+YR**2
        QLAS = 0.0
        *IF,USE_LASER,EQ,1,THEN
            *IF,RAMP,GT,0.0,THEN
                *IF,R2,LE,RCUT2,THEN
                    QLAS = RAMP*QPEAK*EXP(-2.0*R2/WBEAM**2)
                *ENDIF
            *ENDIF
        *ENDIF
        QPATH(I,J) = QLAS
        *IF,QLAS,GT,QTABLEMAX,THEN
            QTABLEMAX = QLAS
        *ENDIF
    *ENDDO
*ENDDO

! Do not silently solve a laser-on run if the tabulated load is zero.
*IF,USE_LASER,EQ,1,THEN
    *IF,QTABLEMAX,LE,0.0,THEN
        *MSG,FATAL
        Laser heat flux table has zero values everywhere
    *ENDIF
*ENDIF

! ----------------------- APPLY HEAT FLUX ----------------------------
! Select only original SOLID291 elements, NOT SURF152 convection.
! Face and midside nodes must all be in LASER_PATH.
ALLSEL,ALL
ESEL,S,ENAME,,291
CMSEL,S,LASER_PATH,NODE
SF,ALL,HFLUX,%QPATH%
ALLSEL,ALL

! ----------------------- TRANSIENT SOLUTION -------------------------
FINISH
/SOLU
ALLSEL,ALL

! True initial condition: set only the t=0 temperature.
! DO NOT use D,ALL,TEMP,27: that would fix temperature forever.
! DO NOT reset, clamp, or correct temperatures after the solve.
TUNIF,TINIT

! Full transient thermal solver, allowing nonlinear h(T) iterations.
! Backward Euler time integration + diagonalized heat capacity matrix.
THOPT,FULL
TINTP,,,,1.0
AUTOTS,OFF
DELTIM,DT,DT,DT
TIME,TEND
OUTRES,NSOL,ALL
OUTRES,ESOL,ALL

/COM, ============================================================
/COM, DRONE HEATING - INITIAL 27 C, NO TEMPERATURE CLAMPING
/COM, Convection is on SURF152, laser flux is on SOLID291.
/COM, ============================================================
*VWRITE,TINIT,TAMB,TEND,DT
(' INIT, AMBIENT, END, DT: ',4E16.8)
*VWRITE,NPATH,NEXPOSED,NDIAG
(' LASER NODES, EXPOSED NODES, DIAG ETYPES: ',3E16.8)
*VWRITE,PTARGET,QPEAK,QTABLEMAX
(' TARGET POWER, PEAK FLUX, TABLE MAX: ',3E16.8)
*VWRITE,LCHAR,HMIN_NAT,HMAX_NAT
(' LCHAR, HMIN, HMAX: ',3E16.8)
ALLSEL,ALL
! Workbench will execute SOLVE after this Commands object.
! =====================================================================
